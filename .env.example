# Webull OpenAPI (developer.webull.hk) — only required if using source=webull.
# yfinance-only usage does not need any of these set.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
# Region id the SDK resolves default REST/MQTT hosts from (api.webull.hk /
# data-api.webull.hk for "hk"). Paper-trading credentials authenticate against
# separate sandbox hosts the SDK does not know by default — confirmed both
# empirically (REST via scripts/webull_smoketest.py, MQTT via a live
# subscribe) that a PaperTrading app key needs BOTH overrides below. Leave
# both unset only for a production/live app key.
WEBULL_REGION=hk
WEBULL_API_ENDPOINT=api.sandbox.webull.hk
WEBULL_MQTT_ENDPOINT=data-api.sandbox.webull.hk
